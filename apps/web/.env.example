# Template for apps/web/.env.local  (copy and fill in). NAMES AND PLACEHOLDERS ONLY:
# real values live in the untracked .env.local and must never be printed or committed.
# Everything starting with NEXT_PUBLIC_ is sent to the browser, so NEVER put a secret here.
# Razorpay keys and secrets belong only in apps/api/.env, never in this file.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8080
