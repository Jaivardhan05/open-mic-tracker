# Template for apps/api/.env  (copy to .env and fill in). NAMES AND PLACEHOLDERS ONLY:
# the real values live in the untracked .env file and must never be printed or committed.
# Write each line as NAME=value with no quotes and no spaces around "=".

# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Server ---
PORT=8080
# Extra allowed browser origin (optional)
CORS_ORIGIN=

# --- Razorpay (payments; API only, never in the web app) ---
# Key id: rzp_test_... in test mode, rzp_live_... in live mode
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# Key secret that belongs to that key id (shown once in the dashboard; regenerate the PAIR if lost)
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# The secret you typed into the dashboard's webhook form (separate from the key secret)
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
# test or live; must agree with the key id prefix
RAZORPAY_MODE=test
# Shared secret for the internal reconcile call; only needed from Step 10
BILLING_CRON_SECRET=
