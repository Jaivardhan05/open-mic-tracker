# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Any other env file is ignored too; only the committed templates are allowed
.env.*
!.env.example

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Private documents: specs/ is its own PRIVATE git repo (cloned into this folder), never part of this one
/specs/

# Local-only tooling and anything that could hold real payment data. Never commit real UPI IDs,
# QR images or payment screenshots; test data uses fake handles and is generated at run time.
.claude/settings.local.json
.mcp.json
ngrok.yml
*.jsonl
scratch/
local-private/
upi-test-data/
**/screenshots/
*screenshot*
*-qr.*
*.qr.png
